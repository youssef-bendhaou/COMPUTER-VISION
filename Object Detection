      "cell_type": "code",
      "source": [
        "!pip install opencv-python -q\n",
        "\n",
        "from google.colab import drive\n",
        "from google.colab.patches import cv2_imshow\n",
        "import cv2\n",
        "\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "base = '/content/drive/MyDrive/computer vision/Object Detection/'\n",
        "\n",
        "# Noms des classes\n",
        "with open(base + 'coco.names') as f:\n",
        "    Classnames = f.read().strip().split('\\n')\n",
        "\n",
        "# Image\n",
        "image = cv2.imread(base + 'pexels-eggsy-outis-2151852439-33076681.jpg')\n",
        "image = cv2.resize(image, (0, 0), None, 0.2, 0.2)\n",
        "\n",
        "# Modèle\n",
        "config = base + 'ssd_mobilenet_v3_large_coco_2020_01_14.pbtxt'\n",
        "weights = base + 'frozen_inference_graph.pb'\n",
        "detector = cv2.dnn_DetectionModel(weights, config)\n",
        "detector.setInputSize(320, 320)\n",
        "detector.setInputScale(1.0 / 127.5)\n",
        "detector.setInputMean((127.5, 127.5, 127.5))\n",
        "detector.setInputSwapRB(True)\n",
        "\n",
        "ids, confidences, boxes = detector.detect(image, confThreshold=0.5)\n",
        "\n",
        "if len(ids) > 0:\n",
        "    for id, conf, box in zip(ids.flatten(), confidences.flatten(), boxes):\n",
        "        Class = Classnames[id - 1]\n",
        "        confidence = round(float(conf), 2)\n",
        "        x, y, w, h = box\n",
        "\n",
        "        cv2.rectangle(image, box, (0, 0, 255), 3)\n",
        "        cv2.putText(image, Class + ' ' + str(confidence), (x, max(y - 10, 20)),\n",
        "                    cv2.FONT_ITALIC, 0.6, (0, 0, 255), 2)\n",
        "else:\n",
        "    print(\"Aucun objet détecté\")\n",
        "\n",
        "cv2_imshow(image)"
      ],
